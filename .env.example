# Copie este arquivo para ".env" e preencha os valores para rodar localmente.
# Em produção (Railway), NÃO use um arquivo .env: configure essas variáveis
# na aba "Variables" do serviço.

# Gere uma chave nova, por exemplo com:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=troque-por-uma-chave-secreta-gerada

# True só localmente. Em produção, deixe False (ou não defina).
DEBUG=True

# Hosts permitidos, separados por vírgula. No Railway, o domínio público
# é adicionado automaticamente via RAILWAY_PUBLIC_DOMAIN, não precisa repetir aqui.
ALLOWED_HOSTS=localhost,127.0.0.1

# Só precisa definir se for testar contra um MySQL local/remoto.
# No Railway, o plugin de MySQL cria essa variável sozinho.
# Formato: mysql://usuario:senha@host:porta/nome_do_banco
# DATABASE_URL=mysql://root:1234@localhost:3308/auditpro
